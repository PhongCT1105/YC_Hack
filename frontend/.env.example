# ─── Supabase ───────────────────────────────────────────────
# Public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — NEVER expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Linq ────────────────────────────────────────────────────
LINQ_API_URL=https://api.linq.com/v1
LINQ_API_KEY=your-linq-api-key

# ─── Google Gemini ───────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key
# Model used for all agent tasks (classify, decompose, synthesize)
GEMINI_MODEL=gemini-2.0-flash
